# ===== 安全：切勿提交以下内容 =====
# 本地 SDK 路径（含本机绝对路径，无密钥但会泄露环境）
local.properties

# 签名密钥 —— 泄露后他人可冒用你的身份发布应用
*.jks
*.keystore
key.properties
**/key.properties

# 环境变量 / 密钥
.env
*.env
.env.*

# 账号密码等敏感配置
gradle.properties.local

